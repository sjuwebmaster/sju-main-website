RewriteEngine on
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

<IfModule mod_headers.c>
    # Institutional Identity and Discovery
    Header set Link "</about/about-the-university.php>; rel=\"about\", </ai-directory.md>; rel=\"index\", </about/contact-us.php>; rel=\"help\", <https://admissions.sju.edu.in/>; rel=\"registration\""
</IfModule>

# 1. Set default character set to UTF-8
# ============================================================
# CACHING STRATEGY
# ============================================================
<IfModule mod_headers.c>
    # --- OPTION A: DEVELOPMENT MODE (Active) ---
    # Prevents all caching so you see your JS/CSS changes instantly.
   # <FilesMatch "\.(html|php|js|css)$">
      #  Header set Cache-Control "no-cache, no-store, must-revalidate"
     #   Header set Pragma "no-cache"
    #    Header set Expires 0
  #  </FilesMatch>

# ============================================================
# CACHING STRATEGY: PRODUCTION MODE
# ============================================================
<IfModule mod_headers.c>
    # 1. Pages: Check server for updates (revalidate)
    # This keeps your HTML/PHP fresh but allows the browser to store a copy.
    <FilesMatch "\.(html|php)$">
       Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # 2. Assets: Cache for 1 Year (Images, Fonts, JS, CSS)
    # UNCOMMENTED: This fixes the "no-cache" issue for static files.
    <FilesMatch "\.(js|css|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

Header set X-Robots-Tag "noarchive, index, follow"
Header set Link "<https://sju.edu.in/llms.txt>; rel='llms-txt'"

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. External Redirect: Strip .php ONLY if it's not an AJAX request
    # This prevents the redirect from interfering with your fee_fetch.php call
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php
    RewriteCond %{REQUEST_FILENAME} !fee_fetch.php
    RewriteCond %{REQUEST_FILENAME} !news.php
    RewriteCond %{REQUEST_FILENAME} !publications.php
    RewriteCond %{REQUEST_FILENAME} !projects.php
    RewriteCond %{REQUEST_FILENAME} !patents.php
    RewriteCond %{REQUEST_FILENAME} !book-chapters.php
    RewriteCond %{REQUEST_FILENAME} !books-published.php
    RewriteCond %{REQUEST_FILENAME} !consultancy.php
    RewriteCond %{REQUEST_FILENAME} !events-organised.php
    RewriteCond %{REQUEST_FILENAME} !popular-media.php
    RewriteRule ^/?(.*)\.php$ /$1 [L,R=301]

    # 2. Internal Rewrite: silently load the .php file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>
# 2. Disable Directory Browsing
# Prevents users from seeing a list of files in a folder if no index file exists
Options -Indexes


