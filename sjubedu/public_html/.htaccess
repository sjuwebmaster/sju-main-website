# Force HTTPS and WWW in a single redirect hop
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^sju\.edu\.in [NC]
RewriteRule ^(.*)$ https://www.sju.edu.in/$1 [L,R=301]

