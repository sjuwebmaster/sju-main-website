# CUSTOM ERROR DOCUMENTS
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php



# 1. Fix the Hardware Violation
Header set Permissions-Policy "compute-pressure=()"
Header always set X-Content-Type-Options "nosniff"
    
    # FIX FOR ERROR 153: Explicitly allow referrers to be sent to YouTube
    Header always set Referrer-Policy "no-referrer-when-downgrade"
    
    Header always set X-XSS-Protection "1; mode=block"

    # Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Permissions-Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 5. Deny access to sensitive files
# Protects config, logs (including CSP), backups, and environment variables
<FilesMatch "\.(log|ini|env|sql|bak)$|^(config\.php|i_db\.php|csp_violations\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Block access to hidden files (starting with a dot)
# Includes .git, .env, .htaccess, etc.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{SCRIPT_FILENAME} -d [OR]
    RewriteCond %{SCRIPT_FILENAME} -f
    RewriteRule "(^|/)\." - [F]
    
    <IfModule mod_mime.c>
        AddType image/svg+xml .svg .svgz
    </IfModule>
</IfModule>
# ============================================================
# LIGHTWEIGHT WAF (Web Application Firewall)
# ============================================================
RewriteEngine On

# 1. Block Malicious Request Methods (TRACE/TRACK)
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
RewriteRule .* - [F]

# 2. Block aggressive scanners and bad bots
RewriteCond %{HTTP_USER_AGENT} ^.*(libwww-perl|curl|wget|python|nikto|wikto|sf|sqlmap|bsqlbf|w3af|acunetix|havij|appscan).* [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^ApacheBench [NC]
RewriteRule .* - [F,L]

# 3. Block common SQL Injection and XSS patterns in the URL
RewriteCond %{QUERY_STRING} (\|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (javascript:).*(\;) [NC,OR]
RewriteCond %{QUERY_STRING} (UNION|SELECT|INSERT|UPDATE|DELETE|DROP).* [NC,OR]
RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|self/environ) [NC,OR]
RewriteCond %{QUERY_STRING} (base64_encode|localhost|loopback) [NC]
RewriteRule .* - [F,L]
# Block common SQL logic bypass patterns like ' OR 1=1
RewriteCond %{REQUEST_URI} !^/bulletin/bulletin-view [NC]
RewriteCond %{QUERY_STRING} [^a-z](OR|AND)\s+['"]?\d+['"]?\s*=\s*['"]?\d+ [NC,OR]
# Block the SQL comment dash pattern used to hide the rest of a query
RewriteCond %{QUERY_STRING} (--|#|/\*) [NC]
RewriteCond %{REQUEST_URI} !^/bulletin/bulletin-view [NC]
RewriteRule .* - [F,L]


# Force HTTPS in the htaccess file

#RewriteEngine On
